#version 460
// Keryx PoM v4 (D=32 re-walk) — Vulkan compute port of the CUDA `pom_mine_v4` / `pom_mine_v4_ncf`
// kernels. BYTE-IDENTICAL to the node's consensus/core/src/pom_v4.rs and to `src/pom_v4.rs` (the
// host mirror, which re-walks every winner before submit — a kernel bug can cost hashrate, never
// a rejected block).
//
// Per nonce: seed (from the `pom_seed_v4.comp` pre-pass: H10 keccak PowHash front-end, or the pre-H10
// salted mix64 fold) -> S_0 (32x32 int8, mix64 keystream) -> K steps of { read 1 KB tile at the chained offset; S = rho8(S x tile^T) }
// -> blake3 row leaves + depth-5 tree -> fold64(root) -> H3 pow fold -> <= target.
//
// Layout: NPW nonces per workgroup, 32 invocations per nonce (gl_LocalInvocationID.x = state row
// x, .y = nonce slot). Invocation x owns row x as 8 packed uints in registers and loads chunk x
// of every tile — which is exactly tile COLUMN x (column j = tile bytes j*32..j*32+32).
//
// The offset chain depends only on the seed and each tile's first 32 bytes (the snippet), never
// on the walk state, so the next tile's global load is issued BEFORE the current transition and
// lands in registers while the dot products run. The tile is single-buffered in shared memory
// with two barriers per step (both wave-local with one nonce per workgroup): the shared footprint
// — not registers — bounds occupancy, and 2 KB per wave is what lets a SIMD hold 16 waves (RGP on
// a 7900 XT: the 3.1 KB double-buffered layout allocated 4 KB and capped it at 8).
//
// POM_V4_CM (built as pom_walk_v4_cm.spv): the same walk with the 32x32x32 int8 transition on the
// matrix cores (VK_KHR_cooperative_matrix) instead of packed v_dot4 — see the CM main() below.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require
#ifdef POM_V4_CM
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif

// Nonces per workgroup. 1 measured fastest on a 7900 XT (1.12 M/s vs 0.99 at 2, 0.95 at 4, 0.91 at
// 8): with one nonce per workgroup the per-step barrier couples no other walk. The host pins
// wave32, so the workgroup is exactly one full wave.
#ifndef NPW
#define NPW 1
#endif
#if defined(POM_V4_CM) && NPW != 1
#error "the matrix-core walk is one nonce per workgroup (one wave32 subgroup)"
#endif
layout(local_size_x = 32, local_size_y = NPW) in;

#define V4_D4 8u              // packed uints per row / column
#define V4_TILE_UINTS 256u    // 1 KB tile
// Per-slot shared region: the tile (256 uints) + the next-state rows (256 uints, one private 8-uint
// row per invocation); after the last step it is the blake3 tree scratch. Several slots get a
// 16-uint pad so the broadcast column reads of slots sharing a wave64 hit different banks.
#define V4_NEW_OFF 256u
#if NPW > 1
#define V4_SLOT_UINTS 528u
#else
#define V4_SLOT_UINTS 512u
#endif

#define V4_S0_ROW_SALT 0x03421325594C3C51UL       // sha256("keryx-v4-s0-row-salt")
#define V4_OFFSET_FIRST_SALT 0x6D1CCF96AC4D76F9UL // sha256("keryx-v4-offset-first-salt")
#define V4_OFFSET_STEP_SALT 0x89050E78D34609EFUL  // sha256("keryx-v4-offset-step-salt")

// A weight segment (tensor or shard) as little-endian u64 words, reached by device address.
layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer Seg {
    uint64_t words[];
};

// Binding 0: dispatch I/O — the atomicMin winner slot, the 256-bit LE target, and the H10 sponge
// state with pre_pow_hash + timestamp absorbed (`pom::pom_seed_h10_state`, read by the seed
// pre-pass). Host writes it in one mapped pre-dispatch write; only the first 4 bytes are read back.
layout(std430, binding = 0) buffer Io {
    uint offset;
    uint _pad;
    uint64_t t[4];
    uint64_t h10[25];
} IO;
// Binding 1: cumulative canonical-chunk starts per segment (T+1 entries, sentinel = n_chunks).
layout(std430, binding = 1) readonly buffer Prefix { uint64_t p[]; } PREFIX;
// Binding 2: one GPU device address per segment, in segment order.
layout(std430, binding = 2) readonly buffer Addrs { uint64_t a[]; } ADDRS;
// Binding 3: bucket LUT — bits 0..30 of LUT.s[b] = the segment holding chunk (b << lut_sh). A
// chunk's segment is found by a short forward scan from its bucket's entry (identical result to a
// binary search). Bit 31 (V4_LUT_SCAN) is set where that segment ends before the bucket does (or,
// with buckets smaller than a tile, before the tile starting at the bucket does): a clear bit
// means every tile starting in the bucket lies in that one segment.
layout(std430, binding = 3) readonly buffer Lut { uint s[]; } LUT;
#define V4_LUT_SCAN 0x80000000u
// Binding 4: per-nonce walk seeds written by the `pom_seed_v4.comp` pre-pass (batch offset index).
layout(std430, binding = 4) readonly buffer Seeds { uint64_t s[]; } SEEDS;

layout(push_constant) uniform Push {
    uint64_t p0, p1, p2, p3;   // POW-fold pph words (H3-salted)
    uint64_t n_tiles;          // floor(n_chunks / 32)
    uint64_t inv_n;            // u64::MAX / n_tiles — Barrett reciprocal for % n_tiles
    uint batch;                // nonces in this dispatch
    uint t_count;              // number of segments (T)
    uint lut_sh;               // LUT bucket shift
    uint zero;                 // always 0 — see rho8
} pc;                          // 48 + 16 = 64 B

#ifdef POM_V4_CM
// Words per tile column and bytes per state row; 8 and 32 are unpadded (2 KB per nonce, the same
// LDS budget as the v_dot4 walk), larger values pad the fragment loads off shared banks.
#ifndef CM_TS
#define CM_TS 8u
#endif
#ifndef CM_SS
#define CM_SS 32u
#endif
// The tile (column x at x*CM_TS); before the walk the layout probe, after it the Merkle scratch.
shared uint s_mem[32u * CM_TS];
// The walk state, row x at x*CM_SS — int8 so the matrix-core loads read it directly.
shared int8_t s_state[32u * CM_SS];
#else
shared uint s_mem[NPW * V4_SLOT_UINTS];
#endif

// splitmix64 finalizer — exactly `pom::mix64`.
uint64_t mix64(uint64_t x) {
    x ^= x >> 30;
    x *= 0xbf58476d1ce4e5b9UL;
    x ^= x >> 27;
    x *= 0x94d049bb133111ebUL;
    x ^= x >> 31;
    return x;
}

// High 64 bits of a 64x64 product, from 32-bit partial products.
uint64_t mulhi64(uint64_t a, uint64_t b) {
    uint a0 = uint(a), a1 = uint(a >> 32), b0 = uint(b), b1 = uint(b >> 32);
    uint h00, l00, h01, l01, h10, l10, h11, l11;
    umulExtended(a0, b0, h00, l00);
    umulExtended(a0, b1, h01, l01);
    umulExtended(a1, b0, h10, l10);
    umulExtended(a1, b1, h11, l11);
    // a*b = p11*2^64 + (p01 + p10)*2^32 + p00; carry the middle column into the high word.
    uint64_t mid = uint64_t(h00) + uint64_t(l01) + uint64_t(l10);
    return ((uint64_t(h11) << 32) | uint64_t(l11)) + uint64_t(h01) + uint64_t(h10) + (mid >> 32);
}

// x % n_tiles, exact: with 2^64 - 1 = inv*n + e (0 <= e < n), x * inv / 2^64 = x/n - x(1 + e) /
// (n 2^64), which is <= x/n and > x/n - 1, so q = floor(x * inv / 2^64) is floor(x/n) or one less:
// 0 <= r < 2n, and one conditional subtract (a select; a correction loop stalls on its back-branch)
// finishes it.
uint64_t mod_tiles(uint64_t x) {
    const uint64_t r = x - mulhi64(x, pc.inv_n) * pc.n_tiles;
    return r >= pc.n_tiles ? r - pc.n_tiles : r;
}

// rho8 — the murmur-style byte reduction (`pom_v3::rho8`). Only bits 0..7 and 13..20 of the second
// product reach the byte, and a product's low 24 bits depend only on its factors' low 24 bits, so
// that multiply runs on 24-bit factors: a full-rate v_mul_u32_u24 instead of the quarter-rate
// v_mul_lo_u32 (+8% on a 7900 XT). The width-24 extract takes its offset from the push constant
// `zero`: with a literal 0 the compiler drops the mask as redundant for the bits the product
// needs, loses the proof that the factor fits in 24 bits, and goes back to v_mul_lo_u32.
uint rho8(int acc, uint tweak) {
    uint z = uint(acc) ^ tweak;
    z *= 0x9E3779B9u;
    z ^= z >> 16;
    z = bitfieldExtract(z, int(pc.zero), 24);
    z *= 0x85EBCA6Bu & 0xFFFFFFu;
    z ^= z >> 13;
    return z & 0xffu;
}

// --- blake3 (single-chunk path: inputs <= 64 B here, counter 0) ---

const uint B3_IV0 = 0x6A09E667u, B3_IV1 = 0xBB67AE85u, B3_IV2 = 0x3C6EF372u, B3_IV3 = 0xA54FF53Au;
const uint B3_IV4 = 0x510E527Fu, B3_IV5 = 0x9B05688Cu, B3_IV6 = 0x1F83D9ABu, B3_IV7 = 0x5BE0CD19u;
#define B3_FLAGS_ONE_BLOCK 11u // CHUNK_START | CHUNK_END | ROOT

uint b3_rotr(uint x, int n) {
    return (x >> n) | (x << (32 - n));
}

#define B3_G(v, a, b, c, d, mx, my)                                   \
    v[a] += v[b] + (mx); v[d] = b3_rotr(v[d] ^ v[a], 16);             \
    v[c] += v[d];        v[b] = b3_rotr(v[b] ^ v[c], 12);             \
    v[a] += v[b] + (my); v[d] = b3_rotr(v[d] ^ v[a], 8);              \
    v[c] += v[d];        v[b] = b3_rotr(v[b] ^ v[c], 7)

void b3_permute(inout uint m[16]) {
    uint p[16];
    p[0] = m[2];  p[1] = m[6];  p[2] = m[3];   p[3] = m[10];
    p[4] = m[7];  p[5] = m[0];  p[6] = m[4];   p[7] = m[13];
    p[8] = m[1];  p[9] = m[11]; p[10] = m[12]; p[11] = m[5];
    p[12] = m[9]; p[13] = m[14]; p[14] = m[15]; p[15] = m[8];
    [[unroll]] for (int i = 0; i < 16; i++) m[i] = p[i];
}

// One-block blake3 hash (block_len bytes of m, zero-padded) from the IV, written as 8 words.
void b3_one_block(uint m[16], uint block_len, out uint h[8]) {
    uint v[16];
    v[0] = B3_IV0; v[1] = B3_IV1; v[2] = B3_IV2; v[3] = B3_IV3;
    v[4] = B3_IV4; v[5] = B3_IV5; v[6] = B3_IV6; v[7] = B3_IV7;
    v[8] = B3_IV0; v[9] = B3_IV1; v[10] = B3_IV2; v[11] = B3_IV3;
    v[12] = 0u; v[13] = 0u; v[14] = block_len; v[15] = B3_FLAGS_ONE_BLOCK;
    [[unroll]] for (int r = 0; r < 7; r++) {
        B3_G(v, 0, 4, 8, 12, m[0], m[1]);
        B3_G(v, 1, 5, 9, 13, m[2], m[3]);
        B3_G(v, 2, 6, 10, 14, m[4], m[5]);
        B3_G(v, 3, 7, 11, 15, m[6], m[7]);
        B3_G(v, 0, 5, 10, 15, m[8], m[9]);
        B3_G(v, 1, 6, 11, 12, m[10], m[11]);
        B3_G(v, 2, 7, 8, 13, m[12], m[13]);
        B3_G(v, 3, 4, 9, 14, m[14], m[15]);
        if (r < 6) b3_permute(m);
    }
    [[unroll]] for (int i = 0; i < 8; i++) h[i] = v[i] ^ v[i + 8];
}

// The 4 u64 words of canonical chunk `idx`: segment from the bucket LUT + forward scan.
Seg chunk_ptr(uint64_t idx) {
    uint lo = LUT.s[uint(idx >> pc.lut_sh)] & ~V4_LUT_SCAN;
    while (lo + 1u < pc.t_count && PREFIX.p[lo + 1u] <= idx) {
        lo++;
    }
    return Seg(ADDRS.a[lo] + (idx - PREFIX.p[lo]) * 32UL);
}

// pom_pow_value (H3) of the walk's folded root: 4 keyed mix64 folds -> 256-bit LE value; a value
// at or under the target makes nonce `i` a winner (lowest batch index wins).
void report(uint64_t fin, uint i) {
    uint64_t o0 = mix64(fin ^ pc.p0 ^ 0x9E3779B97F4A7C15UL);
    uint64_t o1 = mix64(o0 ^ pc.p1 ^ 0xC2B2AE3D27D4EB4FUL);
    uint64_t o2 = mix64(o1 ^ pc.p2 ^ 0x165667B19E3779F9UL);
    uint64_t o3 = mix64(o2 ^ pc.p3 ^ 0xD6E8FEB86659FD93UL);
    bool le;
    if (o3 != IO.t[3]) { le = o3 < IO.t[3]; }
    else if (o2 != IO.t[2]) { le = o2 < IO.t[2]; }
    else if (o1 != IO.t[1]) { le = o1 < IO.t[1]; }
    else { le = o0 <= IO.t[0]; }
    if (le) {
        atomicMin(IO.offset, i);
    }
}

#ifdef POM_V4_CM
// Matrix-core transition: next = S x T^T as 2x2 output blocks of 16x16, each the sum of two
// 16x16x16 int8 products with A = state rows (row-major in s_state) and B(k, j) = tile byte
// j*32 + k (the tile column-major in s_mem). The products are exact int32, so the walk is
// byte-identical to the v_dot4 path. rho8 runs on the accumulator elements in registers; the
// element -> (row, col) layout is implementation-defined, so it is read once from a position
// matrix (element (r, c) = r*16 + c) loaded the same way. New state bytes are written in place:
// a 16-row block's A fragments are in registers before any of its bytes are stored, and the other
// block's rows are disjoint.
#define CM_ACC coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define CM_A coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define CM_B coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define CM_ELEMS 8u // accumulator elements per invocation: 256 over the host-pinned wave32

// Column x of tile `off` (canonical chunk off*32 + x). off is wave-uniform, so the segment is
// resolved once on the scalar unit: an entry without V4_LUT_SCAN names the segment holding the
// whole tile, and the address needs only PREFIX[lo] and ADDRS[lo], both read together. A flagged
// bucket scans forward (PREFIX[T] = n_chunks is past every tile, so lo stays below T); only a
// tile that straddles a segment start — a handful per table — takes the per-lane lookup.
void load_column(uint64_t off, uint x, out uint64_t w0, out uint64_t w1, out uint64_t w2, out uint64_t w3) {
    const uint64_t t0 = off * 32UL;
    const uint e = LUT.s[uint(t0 >> pc.lut_sh)];
    uint lo = e & ~V4_LUT_SCAN;
    Seg c;
    if (e < V4_LUT_SCAN) {
        c = Seg(ADDRS.a[lo] + (t0 - PREFIX.p[lo]) * 32UL + uint64_t(x * 32u));
    } else {
        uint64_t p1 = PREFIX.p[lo + 1u];
        while (p1 <= t0) {
            lo++;
            p1 = PREFIX.p[lo + 1u];
        }
        c = t0 + 31UL < p1 ? Seg(ADDRS.a[lo] + (t0 - PREFIX.p[lo]) * 32UL + uint64_t(x * 32u))
                           : chunk_ptr(t0 + uint64_t(x));
    }
    w0 = c.words[0]; w1 = c.words[1]; w2 = c.words[2]; w3 = c.words[3];
}

void main() {
    const uint x = gl_LocalInvocationID.x;     // state row == tile column this invocation loads
    const uint i = gl_WorkGroupID.x;
    // Past the batch: walk the last seed (every barrier is reached), never report.
    const uint64_t seed = SEEDS.s[min(i, pc.batch - 1u)];
    // The host pins wave32 (one nonce = one subgroup) and checks this before using the kernel.
    if (i == 0u && x == 0u) {
        IO._pad = gl_SubgroupSize;
    }

    // Accumulator element layout: the position (row*16 + col) of each element this lane holds.
    for (uint p = x; p < 256u; p += 32u) {
        s_mem[p] = p;
    }
    barrier();
    uint tw_pos[CM_ELEMS];   // row * rho_tweak_row + col * rho_tweak_col within a block
    uint st_pos[CM_ELEMS];   // byte offset within a block of s_state
    {
        CM_ACC probe;
        coopMatLoad(probe, s_mem, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        [[unroll]] for (uint e = 0u; e < CM_ELEMS; e++) {
            const uint p = uint(probe[e]);
            const uint r = p >> 4u, c = p & 15u;
            tw_pos[e] = r * 0xC2B2AE35u + c * 0x85EBCA6Bu;
            st_pos[e] = r * CM_SS + c;
        }
    }

    // S_0: mix64 keystream per row, as the little-endian bytes of row x.
    {
        uint64_t h = mix64(seed ^ (V4_S0_ROW_SALT + uint64_t(x)));
        [[unroll]] for (uint k4 = 0u; k4 < V4_D4; k4++) {
            h = mix64(h);
            const uint w = uint(h);
            [[unroll]] for (uint b = 0u; b < 4u; b++) {
                s_state[x * CM_SS + k4 * 4u + b] = int8_t(w >> (8u * b));
            }
        }
    }

    // Prefetch tile 1's column x into registers.
    uint64_t off = mod_tiles(mix64(seed ^ V4_OFFSET_FIRST_SALT));
    uint64_t w0, w1, w2, w3;
    load_column(off, x, w0, w1, w2, w3);
    barrier(); // the probe is read before the first tile overwrites it

    uint64_t step_salt = V4_OFFSET_STEP_SALT; // (step + 1) * V4_OFFSET_STEP_SALT once advanced
    for (uint step = 1u; step <= 256u; step++) {
        const uint col = x * CM_TS;
        s_mem[col + 0u] = uint(w0); s_mem[col + 1u] = uint(w0 >> 32);
        s_mem[col + 2u] = uint(w1); s_mem[col + 3u] = uint(w1 >> 32);
        s_mem[col + 4u] = uint(w2); s_mem[col + 5u] = uint(w2 >> 32);
        s_mem[col + 6u] = uint(w3); s_mem[col + 7u] = uint(w3 >> 32);

        // Next offset from THIS tile's snippet — its first 32 bytes: column 0, lane 0's w0..w3
        // (invocation x is lane x of the one wave32 subgroup) — taken from registers, so the
        // scalar chain runs while the stores drain instead of after an LDS round trip.
        if (step < 256u) {
            const uint sn[8] = uint[8](
                subgroupBroadcastFirst(uint(w0)), subgroupBroadcastFirst(uint(w0 >> 32)),
                subgroupBroadcastFirst(uint(w1)), subgroupBroadcastFirst(uint(w1 >> 32)),
                subgroupBroadcastFirst(uint(w2)), subgroupBroadcastFirst(uint(w2 >> 32)),
                subgroupBroadcastFirst(uint(w3)), subgroupBroadcastFirst(uint(w3 >> 32)));
            uint64_t sf = 0UL;
            [[unroll]] for (uint w = 0u; w < 8u; w++) {
                sf = mix64(sf ^ uint64_t(sn[w]));
            }
            step_salt += V4_OFFSET_STEP_SALT;
            off = mod_tiles(mix64(seed ^ step_salt ^ sf));
        }
        // Ahead of the next tile's load: after it, the barrier would wait for that load to land.
        barrier();
        // The next tile's load is in flight during the transition.
        if (step < 256u) {
            load_column(off, x, w0, w1, w2, w3);
        }

        // B[kb][jb]: rows k = 16kb.., columns j = 16jb.. — column j is tile column j.
        CM_B b[2][2];
        [[unroll]] for (uint kb = 0u; kb < 2u; kb++) {
            [[unroll]] for (uint jb = 0u; jb < 2u; jb++) {
                coopMatLoad(b[kb][jb], s_mem, jb * 16u * CM_TS + kb * 4u, CM_TS, gl_CooperativeMatrixLayoutColumnMajor);
            }
        }
        const uint step_tw = step * 0x9E3779B9u;
        [[unroll]] for (uint xb = 0u; xb < 2u; xb++) {
            CM_A a0, a1;
            coopMatLoad(a0, s_state, xb * 16u * CM_SS, CM_SS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a1, s_state, xb * 16u * CM_SS + 16u, CM_SS, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint jb = 0u; jb < 2u; jb++) {
                CM_ACC acc = CM_ACC(0);
                acc = coopMatMulAdd(a0, b[0][jb], acc);
                acc = coopMatMulAdd(a1, b[1][jb], acc);
                const uint blk_tw = step_tw + xb * (16u * 0xC2B2AE35u) + jb * (16u * 0x85EBCA6Bu);
                const uint blk_st = xb * 16u * CM_SS + jb * 16u;
                [[unroll]] for (uint e = 0u; e < CM_ELEMS; e++) {
                    s_state[blk_st + st_pos[e]] = int8_t(rho8(int(acc[e]), blk_tw + tw_pos[e]));
                }
            }
        }
        // The state is complete and this tile is fully read before the next step.
        barrier();
    }

    // root_K: 32 blake3 row leaves + complete depth-5 tree, in place in s_mem (each level's lanes
    // read their two children before any of them writes its parent over them).
    {
        uint m[16];
        [[unroll]] for (uint k4 = 0u; k4 < V4_D4; k4++) {
            uint w = 0u;
            [[unroll]] for (uint b = 0u; b < 4u; b++) {
                w |= (uint(int(s_state[x * CM_SS + k4 * 4u + b])) & 0xffu) << (8u * b);
            }
            m[k4] = w;
        }
        [[unroll]] for (uint k = 8u; k < 16u; k++) m[k] = 0u;
        uint h[8];
        b3_one_block(m, 32u, h);
        [[unroll]] for (uint k = 0u; k < 8u; k++) s_mem[x * 8u + k] = h[k];
    }
    barrier();
    [[unroll]] for (uint n = 32u; n > 1u; n >>= 1) {
        uint m[16];
        if (x < n / 2u) {
            [[unroll]] for (uint k = 0u; k < 16u; k++) m[k] = s_mem[x * 16u + k];
        }
        barrier();
        if (x < n / 2u) {
            uint h[8];
            b3_one_block(m, 64u, h);
            [[unroll]] for (uint k = 0u; k < 8u; k++) s_mem[x * 8u + k] = h[k];
        }
        barrier();
    }

    if (x == 0u && i < pc.batch) {
        report(uint64_t(s_mem[0]) | (uint64_t(s_mem[1]) << 32), i);
    }
}

#else
void main() {
    const uint x = gl_LocalInvocationID.x;     // state row == tile column this invocation loads
    const uint slot = gl_LocalInvocationID.y;  // nonce slot in the workgroup
    const uint base = slot * V4_SLOT_UINTS;
    const uint i = gl_WorkGroupID.x * uint(NPW) + slot;
    // Slots past the batch still walk (in-bounds: every offset is % n_tiles, and they reuse the
    // last seed) so every invocation reaches every barrier; they just never report.
    const uint64_t seed = SEEDS.s[min(i, pc.batch - 1u)];

    // S_0: mix64 keystream per row.
    uint row4[V4_D4];
    {
        uint64_t h = mix64(seed ^ (V4_S0_ROW_SALT + uint64_t(x)));
        [[unroll]] for (uint k4 = 0u; k4 < V4_D4; k4++) {
            h = mix64(h);
            row4[k4] = uint(h);
        }
    }

    // Prefetch tile 1's column x into registers.
    uint64_t off = mod_tiles(mix64(seed ^ V4_OFFSET_FIRST_SALT));
    uint64_t w0, w1, w2, w3;
    {
        Seg c = chunk_ptr(off * 32UL + uint64_t(x));
        w0 = c.words[0]; w1 = c.words[1]; w2 = c.words[2]; w3 = c.words[3];
    }

    const uint buf = base;
    for (uint step = 1u; step <= 256u; step++) {
        s_mem[buf + x * 8u + 0u] = uint(w0); s_mem[buf + x * 8u + 1u] = uint(w0 >> 32);
        s_mem[buf + x * 8u + 2u] = uint(w1); s_mem[buf + x * 8u + 3u] = uint(w1 >> 32);
        s_mem[buf + x * 8u + 4u] = uint(w2); s_mem[buf + x * 8u + 5u] = uint(w2 >> 32);
        s_mem[buf + x * 8u + 6u] = uint(w3); s_mem[buf + x * 8u + 7u] = uint(w3 >> 32);
        barrier();

        // Next offset from THIS tile's snippet (its first 8 words); issue the next tile's load now
        // so it is in flight during the transition below. (Splitting the lookup's dependent reads
        // across the transition measured no faster: the walk is throughput-bound, not latency-bound.)
        if (step < 256u) {
            uint64_t sf = 0UL;
            [[unroll]] for (uint w = 0u; w < 8u; w++) {
                sf = mix64(sf ^ uint64_t(s_mem[buf + w]));
            }
            off = mod_tiles(mix64(seed ^ (uint64_t(step + 1u) * V4_OFFSET_STEP_SALT) ^ sf));
            Seg c = chunk_ptr(off * 32UL + uint64_t(x));
            w0 = c.words[0]; w1 = c.words[1]; w2 = c.words[2]; w3 = c.words[3];
        }

        // Row x of S_t: byte j = rho8(row . column_j, tweak(step, x, j)) — packed signed 4x8 dots.
        // |acc| <= 32*128*128 = 2^19, exact in i32, so the saturating accumulate never saturates;
        // it is the form that folds the running sum into each v_dot4 (the plain dot + add costs 16
        // extra adds per column group, ~12% of the walk). The column-group loop stays rolled: fully
        // unrolled, the compiler hoists all 256 column loads ahead of the math (256 VGPRs, scratch
        // spills in this loop, minimum occupancy). Each packed word lands in this invocation's
        // private next-row slot (no other invocation touches it, so no barrier).
        const uint tweak0 = step * 0x9E3779B9u + x * 0xC2B2AE35u;
        const uint new_row = base + V4_NEW_OFF + x * 8u;
        [[dont_unroll]] for (uint j4 = 0u; j4 < V4_D4; j4++) {
            uint r[4];
            [[unroll]] for (uint jj = 0u; jj < 4u; jj++) {
                const uint j = j4 * 4u + jj;
                const uint col = buf + j * 8u;
                int acc = 0;
                [[unroll]] for (uint k = 0u; k < V4_D4; k++) {
                    acc = dotPacked4x8AccSatEXT(int(row4[k]), int(s_mem[col + k]), acc);
                }
                r[jj] = rho8(acc, tweak0 + j * 0x85EBCA6Bu);
            }
            // Two 16-bit halves, each a single byte permute.
            s_mem[new_row + j4] = (r[0] | (r[1] << 8u)) | ((r[2] | (r[3] << 8u)) << 16u);
        }
        [[unroll]] for (uint k4 = 0u; k4 < V4_D4; k4++) {
            row4[k4] = s_mem[new_row + k4];
        }
        // Every invocation is done reading this tile (and its own next-state row) before the next
        // step — or, after the last one, the tree — overwrites the slot region.
        barrier();
    }

    // root_K: 32 blake3 row leaves + complete depth-5 tree; scratch = the slot region
    // (leaves at [0, 256), then levels ping-pong with [256, 384)).
    {
        uint m[16];
        [[unroll]] for (uint k = 0u; k < 8u; k++) m[k] = row4[k];
        [[unroll]] for (uint k = 8u; k < 16u; k++) m[k] = 0u;
        uint h[8];
        b3_one_block(m, 32u, h);
        [[unroll]] for (uint k = 0u; k < 8u; k++) s_mem[base + x * 8u + k] = h[k];
    }
    barrier();
    uint src = base;
    uint dst = base + V4_TILE_UINTS;
    [[unroll]] for (uint n = 32u; n > 1u; n >>= 1) {
        if (x < n / 2u) {
            uint m[16];
            [[unroll]] for (uint k = 0u; k < 16u; k++) m[k] = s_mem[src + x * 16u + k];
            uint h[8];
            b3_one_block(m, 64u, h);
            [[unroll]] for (uint k = 0u; k < 8u; k++) s_mem[dst + x * 8u + k] = h[k];
        }
        barrier();
        uint tmp = src; src = dst; dst = tmp;
    }

    if (x == 0u && i < pc.batch) {
        report(uint64_t(s_mem[src]) | (uint64_t(s_mem[src + 1u]) << 32), i);
    }
}
#endif
