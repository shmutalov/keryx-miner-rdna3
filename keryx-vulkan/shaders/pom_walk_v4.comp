#version 460
// Keryx PoM v4 (D=32 re-walk) — Vulkan compute port of the CUDA `pom_mine_v4` / `pom_mine_v4_ncf`
// kernels. BYTE-IDENTICAL to the node's consensus/core/src/pom_v4.rs and to `src/pom_v4.rs` (the
// host mirror, which re-walks every winner before submit — a kernel bug can cost hashrate, never
// a rejected block).
//
// Per nonce: seed (H10 keccak PowHash front-end, or the pre-H10 salted mix64 fold) -> S_0 (32x32
// int8, mix64 keystream) -> K steps of { read 1 KB tile at the chained offset; S = rho8(S x tile^T) }
// -> blake3 row leaves + depth-5 tree -> fold64(root) -> H3 pow fold -> <= target.
//
// Layout: NPW nonces per workgroup, 32 invocations per nonce (gl_LocalInvocationID.x = state row
// x, .y = nonce slot). Invocation x owns row x as 8 packed uints in registers and loads chunk x
// of every tile — which is exactly tile COLUMN x (column j = tile bytes j*32..j*32+32).
//
// The offset chain depends only on the seed and each tile's first 32 bytes (the snippet), never
// on the walk state, so the next tile's global load is issued BEFORE the current transition and
// lands in registers while the dot products run; the tile is double-buffered in shared memory,
// so one barrier per step suffices (a buffer is rewritten two steps after it was read, and the
// intervening barrier orders every read before that write).
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

#ifndef NPW
#define NPW 4
#endif
layout(local_size_x = 32, local_size_y = NPW) in;

#define V4_D4 8u              // packed uints per row / column
#define V4_TILE_UINTS 256u    // 1 KB tile
// Per-slot shared region: two tile buffers (512 uints, reused as the blake3 tree scratch after the
// last step) + 16 pad, so the broadcast column reads of slots sharing a wave64 hit different banks.
#define V4_SLOT_UINTS 528u

#define V4_S0_ROW_SALT 0x03421325594C3C51UL       // sha256("keryx-v4-s0-row-salt")
#define V4_OFFSET_FIRST_SALT 0x6D1CCF96AC4D76F9UL // sha256("keryx-v4-offset-first-salt")
#define V4_OFFSET_STEP_SALT 0x89050E78D34609EFUL  // sha256("keryx-v4-offset-step-salt")

// A weight segment (tensor or shard) as little-endian u64 words, reached by device address.
layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer Seg {
    uint64_t words[];
};

// Binding 0: dispatch I/O — the atomicMin winner slot, the 256-bit LE target, and the H10 sponge
// state with pre_pow_hash + timestamp absorbed (`pom::pom_seed_h10_state`). Host writes it in one
// mapped pre-dispatch write; only the first 4 bytes are read back.
layout(std430, binding = 0) buffer Io {
    uint offset;
    uint _pad;
    uint64_t t[4];
    uint64_t h10[25];
} IO;
// Binding 1: cumulative canonical-chunk starts per segment (T+1 entries, sentinel = n_chunks).
layout(std430, binding = 1) readonly buffer Prefix { uint64_t p[]; } PREFIX;
// Binding 2: one GPU device address per segment, in segment order.
layout(std430, binding = 2) readonly buffer Addrs { uint64_t a[]; } ADDRS;
// Binding 3: bucket LUT — LUT.s[b] = the segment holding chunk (b << lut_sh). A chunk's segment is
// found by a short forward scan from its bucket's entry (identical result to a binary search).
layout(std430, binding = 3) readonly buffer Lut { uint s[]; } LUT;

layout(push_constant) uniform Push {
    uint64_t p0, p1, p2, p3;   // POW-fold pph words (H3-salted)
    uint64_t s0, s1, s2, s3;   // pre-H10 SEED-fold pph words (v4-salted); unused when seed_h10
    uint64_t timestamp;        // header timestamp (pre-H10 seed fold only; H10 has it in IO.h10)
    uint64_t n_tiles;          // floor(n_chunks / 32)
    uint64_t inv_n;            // u64::MAX / n_tiles — Barrett reciprocal for % n_tiles
    uint64_t start_nonce;      // first nonce of this dispatch
    uint batch;                // nonces in this dispatch
    uint t_count;              // number of segments (T)
    uint lut_sh;               // LUT bucket shift
    uint seed_h10;             // 1 = H10 keccak seed, 0 = pre-H10 mix64 fold
} pc;                          // 96 + 16 = 112 B — inside the guaranteed 128 B cap

shared uint s_mem[NPW * V4_SLOT_UINTS];

// splitmix64 finalizer — exactly `pom::mix64`.
uint64_t mix64(uint64_t x) {
    x ^= x >> 30;
    x *= 0xbf58476d1ce4e5b9UL;
    x ^= x >> 27;
    x *= 0x94d049bb133111ebUL;
    x ^= x >> 31;
    return x;
}

// High 64 bits of a 64x64 product, from 32-bit partial products.
uint64_t mulhi64(uint64_t a, uint64_t b) {
    uint a0 = uint(a), a1 = uint(a >> 32), b0 = uint(b), b1 = uint(b >> 32);
    uint h00, l00, h01, l01, h10, l10, h11, l11;
    umulExtended(a0, b0, h00, l00);
    umulExtended(a0, b1, h01, l01);
    umulExtended(a1, b0, h10, l10);
    umulExtended(a1, b1, h11, l11);
    // a*b = p11*2^64 + (p01 + p10)*2^32 + p00; carry the middle column into the high word.
    uint64_t mid = uint64_t(h00) + uint64_t(l01) + uint64_t(l10);
    return ((uint64_t(h11) << 32) | uint64_t(l11)) + uint64_t(h01) + uint64_t(h10) + (mid >> 32);
}

// x % n_tiles, exact: q = floor(x * inv / 2^64) never exceeds floor(x / n), so r >= 0, and it
// undershoots by at most 2, so the correction loop runs at most twice.
uint64_t mod_tiles(uint64_t x) {
    uint64_t r = x - mulhi64(x, pc.inv_n) * pc.n_tiles;
    while (r >= pc.n_tiles) {
        r -= pc.n_tiles;
    }
    return r;
}

// pom_block_seed_from_words — the pre-H10 v4 fold over the v4-salted pph words.
uint64_t seed_fold(uint64_t nonce) {
    uint64_t s = mix64(nonce ^ 0x4B65727978531UL);
    s = mix64(s ^ pc.timestamp);
    s = mix64(s ^ pc.s0);
    s = mix64(s ^ pc.s1);
    s = mix64(s ^ pc.s2);
    s = mix64(s ^ pc.s3);
    return s;
}

// --- Keccak-f[1600] (FIPS 202), identical to khh.comp's B-array round ---

const uint64_t RC[24] = uint64_t[24](
    0x0000000000000001UL, 0x0000000000008082UL, 0x800000000000808aUL, 0x8000000080008000UL,
    0x000000000000808bUL, 0x0000000080000001UL, 0x8000000080008081UL, 0x8000000000008009UL,
    0x000000000000008aUL, 0x0000000000000088UL, 0x0000000080008009UL, 0x000000008000000aUL,
    0x000000008000808bUL, 0x800000000000008bUL, 0x8000000000008089UL, 0x8000000000008003UL,
    0x8000000000008002UL, 0x8000000000000080UL, 0x000000000000800aUL, 0x800000008000000aUL,
    0x8000000080008081UL, 0x8000000000008080UL, 0x0000000080000001UL, 0x8000000080008008UL);

uint64_t rotl64(uint64_t x, uint r) {
    return (x << r) | (x >> (64u - r));
}

void keccakf(inout uint64_t a[25]) {
    for (uint round = 0u; round < 24u; ++round) {
        uint64_t c0 = a[0] ^ a[5] ^ a[10] ^ a[15] ^ a[20];
        uint64_t c1 = a[1] ^ a[6] ^ a[11] ^ a[16] ^ a[21];
        uint64_t c2 = a[2] ^ a[7] ^ a[12] ^ a[17] ^ a[22];
        uint64_t c3 = a[3] ^ a[8] ^ a[13] ^ a[18] ^ a[23];
        uint64_t c4 = a[4] ^ a[9] ^ a[14] ^ a[19] ^ a[24];
        uint64_t d0 = c4 ^ rotl64(c1, 1u);
        uint64_t d1 = c0 ^ rotl64(c2, 1u);
        uint64_t d2 = c1 ^ rotl64(c3, 1u);
        uint64_t d3 = c2 ^ rotl64(c4, 1u);
        uint64_t d4 = c3 ^ rotl64(c0, 1u);
        a[0] ^= d0; a[5] ^= d0; a[10] ^= d0; a[15] ^= d0; a[20] ^= d0;
        a[1] ^= d1; a[6] ^= d1; a[11] ^= d1; a[16] ^= d1; a[21] ^= d1;
        a[2] ^= d2; a[7] ^= d2; a[12] ^= d2; a[17] ^= d2; a[22] ^= d2;
        a[3] ^= d3; a[8] ^= d3; a[13] ^= d3; a[18] ^= d3; a[23] ^= d3;
        a[4] ^= d4; a[9] ^= d4; a[14] ^= d4; a[19] ^= d4; a[24] ^= d4;

        uint64_t b0  = a[0];
        uint64_t b1  = rotl64(a[6],  44u);
        uint64_t b2  = rotl64(a[12], 43u);
        uint64_t b3  = rotl64(a[18], 21u);
        uint64_t b4  = rotl64(a[24], 14u);
        uint64_t b5  = rotl64(a[3],  28u);
        uint64_t b6  = rotl64(a[9],  20u);
        uint64_t b7  = rotl64(a[10],  3u);
        uint64_t b8  = rotl64(a[16], 45u);
        uint64_t b9  = rotl64(a[22], 61u);
        uint64_t b10 = rotl64(a[1],   1u);
        uint64_t b11 = rotl64(a[7],   6u);
        uint64_t b12 = rotl64(a[13], 25u);
        uint64_t b13 = rotl64(a[19],  8u);
        uint64_t b14 = rotl64(a[20], 18u);
        uint64_t b15 = rotl64(a[4],  27u);
        uint64_t b16 = rotl64(a[5],  36u);
        uint64_t b17 = rotl64(a[11], 10u);
        uint64_t b18 = rotl64(a[17], 15u);
        uint64_t b19 = rotl64(a[23], 56u);
        uint64_t b20 = rotl64(a[2],  62u);
        uint64_t b21 = rotl64(a[8],  55u);
        uint64_t b22 = rotl64(a[14], 39u);
        uint64_t b23 = rotl64(a[15], 41u);
        uint64_t b24 = rotl64(a[21],  2u);

        a[0]  = b0  ^ ((~b1)  & b2);
        a[1]  = b1  ^ ((~b2)  & b3);
        a[2]  = b2  ^ ((~b3)  & b4);
        a[3]  = b3  ^ ((~b4)  & b0);
        a[4]  = b4  ^ ((~b0)  & b1);
        a[5]  = b5  ^ ((~b6)  & b7);
        a[6]  = b6  ^ ((~b7)  & b8);
        a[7]  = b7  ^ ((~b8)  & b9);
        a[8]  = b8  ^ ((~b9)  & b5);
        a[9]  = b9  ^ ((~b5)  & b6);
        a[10] = b10 ^ ((~b11) & b12);
        a[11] = b11 ^ ((~b12) & b13);
        a[12] = b12 ^ ((~b13) & b14);
        a[13] = b13 ^ ((~b14) & b10);
        a[14] = b14 ^ ((~b10) & b11);
        a[15] = b15 ^ ((~b16) & b17);
        a[16] = b16 ^ ((~b17) & b18);
        a[17] = b17 ^ ((~b18) & b19);
        a[18] = b18 ^ ((~b19) & b15);
        a[19] = b19 ^ ((~b15) & b16);
        a[20] = b20 ^ ((~b21) & b22);
        a[21] = b21 ^ ((~b22) & b23);
        a[22] = b22 ^ ((~b23) & b24);
        a[23] = b23 ^ ((~b24) & b20);
        a[24] = b24 ^ ((~b20) & b21);
        a[0] ^= RC[round];
    }
}

// H10 seed: lane 0 of keccak_f1600 over the host-absorbed sponge with the nonce in lane 9.
uint64_t seed_h10(uint64_t nonce) {
    uint64_t a[25];
    [[unroll]] for (int i = 0; i < 25; i++) a[i] = IO.h10[i];
    a[9] ^= nonce;
    keccakf(a);
    return a[0];
}

// rho8 — the murmur-style byte reduction (`pom_v3::rho8`).
uint rho8(int acc, uint tweak) {
    uint z = uint(acc) ^ tweak;
    z *= 0x9E3779B9u;
    z ^= z >> 16;
    z *= 0x85EBCA6Bu;
    z ^= z >> 13;
    return z & 0xffu;
}

// --- blake3 (single-chunk path: inputs <= 64 B here, counter 0) ---

const uint B3_IV0 = 0x6A09E667u, B3_IV1 = 0xBB67AE85u, B3_IV2 = 0x3C6EF372u, B3_IV3 = 0xA54FF53Au;
const uint B3_IV4 = 0x510E527Fu, B3_IV5 = 0x9B05688Cu, B3_IV6 = 0x1F83D9ABu, B3_IV7 = 0x5BE0CD19u;
#define B3_FLAGS_ONE_BLOCK 11u // CHUNK_START | CHUNK_END | ROOT

uint b3_rotr(uint x, int n) {
    return (x >> n) | (x << (32 - n));
}

#define B3_G(v, a, b, c, d, mx, my)                                   \
    v[a] += v[b] + (mx); v[d] = b3_rotr(v[d] ^ v[a], 16);             \
    v[c] += v[d];        v[b] = b3_rotr(v[b] ^ v[c], 12);             \
    v[a] += v[b] + (my); v[d] = b3_rotr(v[d] ^ v[a], 8);              \
    v[c] += v[d];        v[b] = b3_rotr(v[b] ^ v[c], 7)

void b3_permute(inout uint m[16]) {
    uint p[16];
    p[0] = m[2];  p[1] = m[6];  p[2] = m[3];   p[3] = m[10];
    p[4] = m[7];  p[5] = m[0];  p[6] = m[4];   p[7] = m[13];
    p[8] = m[1];  p[9] = m[11]; p[10] = m[12]; p[11] = m[5];
    p[12] = m[9]; p[13] = m[14]; p[14] = m[15]; p[15] = m[8];
    [[unroll]] for (int i = 0; i < 16; i++) m[i] = p[i];
}

// One-block blake3 hash (block_len bytes of m, zero-padded) from the IV, written as 8 words.
void b3_one_block(uint m[16], uint block_len, out uint h[8]) {
    uint v[16];
    v[0] = B3_IV0; v[1] = B3_IV1; v[2] = B3_IV2; v[3] = B3_IV3;
    v[4] = B3_IV4; v[5] = B3_IV5; v[6] = B3_IV6; v[7] = B3_IV7;
    v[8] = B3_IV0; v[9] = B3_IV1; v[10] = B3_IV2; v[11] = B3_IV3;
    v[12] = 0u; v[13] = 0u; v[14] = block_len; v[15] = B3_FLAGS_ONE_BLOCK;
    [[unroll]] for (int r = 0; r < 7; r++) {
        B3_G(v, 0, 4, 8, 12, m[0], m[1]);
        B3_G(v, 1, 5, 9, 13, m[2], m[3]);
        B3_G(v, 2, 6, 10, 14, m[4], m[5]);
        B3_G(v, 3, 7, 11, 15, m[6], m[7]);
        B3_G(v, 0, 5, 10, 15, m[8], m[9]);
        B3_G(v, 1, 6, 11, 12, m[10], m[11]);
        B3_G(v, 2, 7, 8, 13, m[12], m[13]);
        B3_G(v, 3, 4, 9, 14, m[14], m[15]);
        if (r < 6) b3_permute(m);
    }
    [[unroll]] for (int i = 0; i < 8; i++) h[i] = v[i] ^ v[i + 8];
}

// The 4 u64 words of canonical chunk `idx`: segment from the bucket LUT + forward scan.
Seg chunk_ptr(uint64_t idx) {
    uint lo = LUT.s[uint(idx >> pc.lut_sh)];
    while (lo + 1u < pc.t_count && PREFIX.p[lo + 1u] <= idx) {
        lo++;
    }
    return Seg(ADDRS.a[lo] + (idx - PREFIX.p[lo]) * 32UL);
}

void main() {
    const uint x = gl_LocalInvocationID.x;     // state row == tile column this invocation loads
    const uint slot = gl_LocalInvocationID.y;  // nonce slot in the workgroup
    const uint base = slot * V4_SLOT_UINTS;
    const uint i = gl_WorkGroupID.x * uint(NPW) + slot;
    // Slots past the batch still walk (in-bounds: every offset is % n_tiles) so every invocation
    // reaches every barrier; they just never report.
    const uint64_t nonce = pc.start_nonce + uint64_t(i);

    // The seed is identical across the slot's 32 invocations; computing it redundantly costs the
    // same wave time as one lane computing it (SIMT), with no broadcast barrier.
    const uint64_t seed = pc.seed_h10 != 0u ? seed_h10(nonce) : seed_fold(nonce);

    // S_0: mix64 keystream per row.
    uint row4[V4_D4];
    {
        uint64_t h = mix64(seed ^ (V4_S0_ROW_SALT + uint64_t(x)));
        [[unroll]] for (uint k4 = 0u; k4 < V4_D4; k4++) {
            h = mix64(h);
            row4[k4] = uint(h);
        }
    }

    // Prefetch tile 1's column x into registers.
    uint64_t off = mod_tiles(mix64(seed ^ V4_OFFSET_FIRST_SALT));
    uint64_t w0, w1, w2, w3;
    {
        Seg c = chunk_ptr(off * 32UL + uint64_t(x));
        w0 = c.words[0]; w1 = c.words[1]; w2 = c.words[2]; w3 = c.words[3];
    }

    for (uint step = 1u; step <= 256u; step++) {
        const uint buf = base + (step & 1u) * V4_TILE_UINTS;
        s_mem[buf + x * 8u + 0u] = uint(w0); s_mem[buf + x * 8u + 1u] = uint(w0 >> 32);
        s_mem[buf + x * 8u + 2u] = uint(w1); s_mem[buf + x * 8u + 3u] = uint(w1 >> 32);
        s_mem[buf + x * 8u + 4u] = uint(w2); s_mem[buf + x * 8u + 5u] = uint(w2 >> 32);
        s_mem[buf + x * 8u + 6u] = uint(w3); s_mem[buf + x * 8u + 7u] = uint(w3 >> 32);
        barrier();

        // Next offset from THIS tile's snippet (its first 8 words); issue the next tile's load now
        // so it is in flight during the transition below.
        if (step < 256u) {
            uint64_t sf = 0UL;
            [[unroll]] for (uint w = 0u; w < 8u; w++) {
                sf = mix64(sf ^ uint64_t(s_mem[buf + w]));
            }
            off = mod_tiles(mix64(seed ^ (uint64_t(step + 1u) * V4_OFFSET_STEP_SALT) ^ sf));
            Seg c = chunk_ptr(off * 32UL + uint64_t(x));
            w0 = c.words[0]; w1 = c.words[1]; w2 = c.words[2]; w3 = c.words[3];
        }

        // Row x of S_t: byte j = rho8(row . column_j, tweak(step, x, j)) — packed signed 4x8 dots.
        // |acc| <= 32*128*128 = 2^19, exact in i32.
        const uint tweak0 = step * 0x9E3779B9u + x * 0xC2B2AE35u;
        uint new4[V4_D4];
        [[unroll]] for (uint j4 = 0u; j4 < V4_D4; j4++) {
            uint packed = 0u;
            [[unroll]] for (uint jj = 0u; jj < 4u; jj++) {
                const uint j = j4 * 4u + jj;
                const uint col = buf + j * 8u;
                int acc = 0;
                [[unroll]] for (uint k = 0u; k < V4_D4; k++) {
                    acc += dotPacked4x8EXT(int(row4[k]), int(s_mem[col + k]));
                }
                packed |= rho8(acc, tweak0 + j * 0x85EBCA6Bu) << (8u * jj);
            }
            new4[j4] = packed;
        }
        [[unroll]] for (uint k4 = 0u; k4 < V4_D4; k4++) {
            row4[k4] = new4[k4];
        }
    }
    // Every invocation is done reading the last tile before the tree overwrites the slot region.
    barrier();

    // root_K: 32 blake3 row leaves + complete depth-5 tree; scratch = the slot's tile region
    // (leaves at [0, 256), then levels ping-pong with [256, 384)).
    {
        uint m[16];
        [[unroll]] for (uint k = 0u; k < 8u; k++) m[k] = row4[k];
        [[unroll]] for (uint k = 8u; k < 16u; k++) m[k] = 0u;
        uint h[8];
        b3_one_block(m, 32u, h);
        [[unroll]] for (uint k = 0u; k < 8u; k++) s_mem[base + x * 8u + k] = h[k];
    }
    barrier();
    uint src = base;
    uint dst = base + V4_TILE_UINTS;
    [[unroll]] for (uint n = 32u; n > 1u; n >>= 1) {
        if (x < n / 2u) {
            uint m[16];
            [[unroll]] for (uint k = 0u; k < 16u; k++) m[k] = s_mem[src + x * 16u + k];
            uint h[8];
            b3_one_block(m, 64u, h);
            [[unroll]] for (uint k = 0u; k < 8u; k++) s_mem[dst + x * 8u + k] = h[k];
        }
        barrier();
        uint tmp = src; src = dst; dst = tmp;
    }

    if (x == 0u && i < pc.batch) {
        const uint64_t fin = uint64_t(s_mem[src]) | (uint64_t(s_mem[src + 1u]) << 32);
        // pom_pow_value (H3): 4 keyed mix64 folds -> 256-bit LE value, then le_leq vs target.
        uint64_t o0 = mix64(fin ^ pc.p0 ^ 0x9E3779B97F4A7C15UL);
        uint64_t o1 = mix64(o0 ^ pc.p1 ^ 0xC2B2AE3D27D4EB4FUL);
        uint64_t o2 = mix64(o1 ^ pc.p2 ^ 0x165667B19E3779F9UL);
        uint64_t o3 = mix64(o2 ^ pc.p3 ^ 0xD6E8FEB86659FD93UL);
        bool le;
        if (o3 != IO.t[3]) { le = o3 < IO.t[3]; }
        else if (o2 != IO.t[2]) { le = o2 < IO.t[2]; }
        else if (o1 != IO.t[1]) { le = o1 < IO.t[1]; }
        else { le = o0 <= IO.t[0]; }
        if (le) {
            atomicMin(IO.offset, i);
        }
    }
}
